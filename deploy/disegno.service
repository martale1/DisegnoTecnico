[Unit]
Description=Disegno - laboratorio di assonometria cavaliera
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/DisegnoTecnico
Environment=HOST=0.0.0.0
Environment=PORT=3001
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
